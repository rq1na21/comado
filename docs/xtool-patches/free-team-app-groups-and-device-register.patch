@@ -67,3 +68,30 @@ struct DSDevicesListCommand: AsyncParsableCommand {
         }
     }
 }
+
+// comado: USB なしで端末を登録し直す（無料チームは 7 日で登録が切れる）
+struct DSDevicesRegisterCommand: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(
+        commandName: "register",
+        abstract: "Register a device by UDID"
+    )
+
+    @Option var udid: String
+    @Option var name: String
+
+    func run() async throws {
+        let client = DeveloperAPIClient(auth: try AuthToken.saved().authData())
+        let response = try await client.devicesCreateInstance(
+            body: .json(.init(data: .init(
+                _type: .devices,
+                attributes: .init(name: name, platform: .init(.ios), udid: udid)
+            )))
+        )
+        if (try? response.conflict) != nil {
+            print("already registered (or conflict)")
+            return
+        }
+        _ = try response.created
+        print("registered")
+    }
+}
